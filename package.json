{
  "name": "react-free-upload-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/next-app"
  ],
  "scripts": {
    "build:packages": "tsc -p packages/core && tsc -p packages/react",
    "build": "npm run build:packages && npm run build -w react-free-upload-example",
    "typecheck": "npm run build:packages && tsc --noEmit -p tsconfig.check.json && tsc --noEmit -p examples/next-app",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev": "npm run build:packages && npm run dev -w react-free-upload-example"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "4.13.0",
    "eslint": "^9.0.0",
    "jsdom": "25.0.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "4.1.10",
    "playwright": "1.64.1"
  },
  "license": "MIT",
  "version": "0.1.0"
}
